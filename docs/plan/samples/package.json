    "@fontsource/spline-sans-mono": "^5",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@lhci/cli": "^0.15",
    "@playwright/test": "^1.62.1",
    "prettier": "^3",
    "prettier-plugin-astro": "^0.14",
    "typescript": "^5",
    "wrangler": "^4.134.0"
  }
}
