{
  "name": "keithhuster.com",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": { "node": ">=24", "bun": ">=1.4" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
