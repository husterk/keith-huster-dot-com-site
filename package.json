{
  "name": "keith-huster-dot-com-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/resume-pdf.mjs",
    "preview": "astro preview",
    "check": "wrangler types && astro check && prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test",
    "secrets:local": "op inject -i .dev.vars.tpl -o .dev.vars",
    "types": "wrangler types",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/topojson-client": "3.1.5",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "simple-icons": "16.33.0",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "us-atlas": "3.0.1",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "lighthouse": "13.5.0"
  }
}
