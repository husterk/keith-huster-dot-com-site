{
  "name": "keith-huster-dot-com-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/resume-pdf.mjs",
    "preview": "astro preview",
    "check": "wrangler types && astro check && prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test",
    "secrets:local": "op inject -i .dev.vars.tpl -o .dev.vars",
    "types": "wrangler types",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/topojson-client": "3.1.5",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "simple-icons": "16.36.0",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "us-atlas": "3.0.1",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "lighthouse": "13.6.0"
  }
}
