---
import { getChart } from '../lib/content';

const rows = await getChart();

const WIDTH = 1280;
const BASE = 300;
const LEFT_Y = 270;
const RIGHT_Y = 48;
const SCALE_Y = 0.7;
const TIER_GAP = 60;
const FIRST_TIER_Y = 28;
const ORG_CHAR = 10.4;
const MONO_CHAR = 7.2;

const months = (ym: string) => {
  const [year, month] = ym.split('-').map(Number);
  return year * 12 + month;
};
const today = new Date();
const firstMonth = months(rows[0].start);
const span = today.getFullYear() * 12 + today.getMonth() + 1 - firstMonth;
const xAt = (ym: string) => Math.round((WIDTH * (months(ym) - firstMonth)) / span);
const yAt = (x: number) => LEFT_Y - ((LEFT_Y - RIGHT_Y) * x) / WIDTH;

const points = rows.map((row, index) => {
  const x = xAt(row.start);
  return { ...row, n: index + 1, x, y: yAt(x), year: row.start.slice(0, 4) };
});

const nearWaypoint = (x: number) => points.some((p) => Math.abs(p.x - x) < 24);
const samples: [number, number][] = [];
for (let x = 0; x < WIDTH; x += 40) {
  if (!nearWaypoint(x)) samples.push([x, yAt(x) + ((x / 40) % 2 ? 0 : 10)]);
}
const profile = [...samples, ...points.map((p): [number, number] => [p.x, p.y])].sort(
  (a, b) => a[0] - b[0],
);
profile.push([WIDTH, yAt(WIDTH)]);
const pathOf = (pts: [number, number][], sx = 1, sy = 1, ox = 0, oy = 0) =>
  pts
    .map(([x, y], i) => `${i ? 'L' : 'M'}${(ox + x * sx).toFixed(1)},${(oy + y * sy).toFixed(1)}`)
    .join(' ');

const lines = (p: (typeof points)[number]) => [p.title, p.team].filter((l): l is string => !!l);
const anchors = ['start', 'middle', 'end'] as const;
const labels = points.map((p) => {
  const width =
    Math.max(p.org.length * ORG_CHAR, ...lines(p).map((l) => l.length * MONO_CHAR)) + 16;
  const candidates = anchors
    .map((anchor) => {
      const x0 = anchor === 'start' ? p.x : anchor === 'middle' ? p.x - width / 2 : p.x - width;
      const x1 = x0 + width;
      const covered = points.filter((o) => o !== p && o.x > x0 && o.x < x1).length;
      return { anchor, x0, x1, covered };
    })
    .filter((c) => c.x0 >= -8 && c.x1 <= WIDTH + 8);
  const best = candidates.reduce((a, b) => (b.covered < a.covered ? b : a), candidates[0]);
  return { p, anchor: best.anchor, x0: best.x0, x1: best.x1, tier: 0 };
});
const spans = (a: (typeof labels)[number], b: (typeof labels)[number]) =>
  a !== b && b.p.x > a.x0 && b.p.x < a.x1;
const mustBeAbove = (a: (typeof labels)[number], b: (typeof labels)[number]) =>
  spans(a, b) && (!spans(b, a) || a.p.x > b.p.x);
const overlaps = (a: (typeof labels)[number], b: (typeof labels)[number]) =>
  a !== b && a.tier === b.tier && a.x0 < b.x1 + 12 && b.x0 < a.x1 + 12;
for (let pass = 0; pass < 20; pass += 1) {
  let changed = false;
  for (const a of labels) {
    for (const b of labels) {
      if (mustBeAbove(a, b) && a.tier <= b.tier) {
        a.tier = b.tier + 1;
        changed = true;
      }
    }
  }
  for (const a of labels) {
    for (const b of labels) {
      if (overlaps(a, b) && b.p.x > a.p.x) {
        b.tier += 1;
        changed = true;
      }
    }
  }
  if (!changed) break;
}
const tiers = Math.max(...labels.map((l) => l.tier)) + 1;
const orgY = (tier: number) => FIRST_TIER_Y + TIER_GAP * (tiers - 1 - tier);
const profileTop = FIRST_TIER_Y + TIER_GAP * (tiers - 1) + 44;
const wideHeight = profileTop + BASE * SCALE_Y + 40;
const Y = (y: number) => profileTop + y * SCALE_Y;
const baselineY = Y(BASE);

const years = points.map((p, i) => {
  const next = points[i + 1];
  const prev = points[i - 1];
  let anchor = 'middle';
  if (i === 0) anchor = 'start';
  else if (next && next.x - p.x < 60) anchor = 'end';
  else if (prev && p.x - prev.x < 60) anchor = 'start';
  return { x: p.x, year: p.year, anchor };
});

const NARROW = { w: 390, h: 160, ox: 14, oy: 10, sx: 362 / 1280, sy: 0.42 };
const narrowX = (x: number) => (NARROW.ox + x * NARROW.sx).toFixed(1);
const narrowY = (y: number) => (NARROW.oy + y * NARROW.sy).toFixed(1);

const pad = (n: number) => String(n).padStart(2, '0');
const range = (p: (typeof points)[number]) => `${p.year} to ${p.end ? p.end.slice(0, 4) : 'now'}`;
const summary = points.map((p) => `${p.org} from ${p.year}`).join(', then ');
---

<div class="chartwrap">
  <svg
    class="chart chart-wide"
    viewBox={`-16 0 ${WIDTH + 32} ${wideHeight}`}
    width="100%"
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={`Career elevation chart, ${points[0].year} to now: ${summary}.`}
  >
    <g class="grid">
      {[60, 120, 180, 240].map((y) => (
        <line x1="0" y1={Y(y)} x2={WIDTH} y2={Y(y)} />
      ))}
    </g>
    <g transform={`translate(0,${profileTop}) scale(1,${SCALE_Y})`}>
      <path class="area" d={`${pathOf(profile)} L${WIDTH},${BASE} L0,${BASE} Z`} />
      <path class="line" d={pathOf(profile)} vector-effect="non-scaling-stroke" />
    </g>
    <line class="axis" x1="0" y1={baselineY} x2={WIDTH} y2={baselineY} />
    <g class="drops">
      {points
        .filter((p) => p.x > 0)
        .map((p) => (
          <line x1={p.x} y1={Y(p.y)} x2={p.x} y2={baselineY} />
        ))}
    </g>
    <g class="leaders">
      {labels.map(({ p, tier }) => (
        <line
          x1={Math.max(p.x, 1)}
          y1={orgY(tier) + (p.team ? 40 : 24) + 6}
          x2={Math.max(p.x, 1)}
          y2={Y(p.y) - 9}
        />
      ))}
    </g>
    <g class="dots">
      {points.map((p) => (
        <circle cx={p.x} cy={Y(p.y)} r="6" />
      ))}
      <circle cx={WIDTH} cy={Y(yAt(WIDTH))} r="6" />
    </g>
    {labels.map(({ p, anchor, tier }) => (
      <g class="label" text-anchor={anchor}>
        <text class="org" x={p.x} y={orgY(tier)}>
          {p.org}
        </text>
        {lines(p).map((line, i) => (
          <text class="ttl" x={p.x} y={orgY(tier) + 18 + 16 * i}>
            {line}
          </text>
        ))}
      </g>
    ))}
    <g class="years">
      {years.map((y) => (
        <text x={y.x} y={baselineY + 26} text-anchor={y.anchor}>
          {y.year}
        </text>
      ))}
      <text x={WIDTH} y={baselineY + 26} text-anchor="end">
        NOW
      </text>
    </g>
  </svg>

  <svg
    class="chart chart-narrow"
    viewBox={`0 0 ${NARROW.w} ${NARROW.h}`}
    width="100%"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    <path
      class="area"
      d={`${pathOf(profile, NARROW.sx, NARROW.sy, NARROW.ox, NARROW.oy)} L${narrowX(WIDTH)},${narrowY(BASE)} L${narrowX(0)},${narrowY(BASE)} Z`}
    />
    <path class="line" d={pathOf(profile, NARROW.sx, NARROW.sy, NARROW.ox, NARROW.oy)} />
    <line class="axis" x1={narrowX(0)} y1={narrowY(BASE)} x2={narrowX(WIDTH)} y2={narrowY(BASE)} />
    <g class="dots">
      {points.map((p) => (
        <circle cx={narrowX(p.x)} cy={narrowY(p.y)} r="9" />
      ))}
    </g>
    <g class="nums">
      {points.map((p) => (
        <text x={narrowX(p.x)} y={Number(narrowY(p.y)) + 3.5} text-anchor="middle">
          {pad(p.n)}
        </text>
      ))}
    </g>
    <g class="years">
      <text x={narrowX(0)} y={Number(narrowY(BASE)) + 18}>
        {points[0].year}
      </text>
      <text x={narrowX(WIDTH)} y={Number(narrowY(BASE)) + 18} text-anchor="end">
        NOW
      </text>
    </g>
  </svg>

  <ol class="chart-legend">
    {points.map((p) => (
      <li>
        <span class="n">{pad(p.n)}</span>
        <span class="yrs">{range(p)}</span>
        <span class="o">{p.org}</span>
        <span class="t">
          {p.title}
          {p.team ? `, ${p.team}` : ''}
        </span>
      </li>
    ))}
  </ol>
</div>
