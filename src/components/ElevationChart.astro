---
import { getChart } from '../lib/content';

const waypoints = await getChart();

const profilePath =
  'M0,270 L40,262 80,268 120,250 160,255 200,236 240,242 280,222 320,230 360,208 400,214 440,196 480,204 520,186 560,192 600,176 640,182 693,168 740,172 790,150 840,156 890,132 940,138 990,112 1045,104 1090,110 1140,84 1188,70 1225,76 1262,52 1280,48';

const gridLines = [60, 120, 180, 240];

const labelOffsets: Record<number, { dx: number; dy: number }> = {
  0: { dx: 14, dy: -38 },
  1: { dx: -40, dy: -42 },
  2: { dx: 0, dy: -48 },
};

const dropLines = waypoints
  .map((point, index) => ({ point, index }))
  .filter(({ point, index }) => point.label && index > 0);

const summary = waypoints
  .filter((point) => point.label)
  .map((point) => `${point.label} (${point.year})`)
  .join(', then ');
---

<div class="chartwrap">
  <svg
    class="chart"
    width="1280"
    height="360"
    role="img"
    aria-label={`Career elevation chart, 2002 to now: ${summary}.`}
  >
    <g style="stroke: rgba(235, 230, 216, 0.07); stroke-width: 1;">
      {gridLines.map((y) => (
        <line x1="0" y1={y} x2="1280" y2={y} />
      ))}
    </g>
    <path d={`${profilePath} L1280,300 L0,300 Z`} style="fill: rgba(235, 230, 216, 0.05);" />
    <path
      d={profilePath}
      style="fill: none; stroke-width: 2.5; stroke-linejoin: round;"
      stroke="var(--accent)"
    />
    <line
      x1="0"
      y1="300"
      x2="1280"
      y2="300"
      style="stroke: rgba(235, 230, 216, 0.38); stroke-width: 1;"
    />
    <g style="stroke: rgba(235, 230, 216, 0.38); stroke-width: 1; stroke-dasharray: 3 5;">
      {dropLines.map(({ point }) => (
        <line x1={point.x} y1={point.y} x2={point.x} y2="300" />
      ))}
    </g>
    <line x1="604" y1="146" x2="636" y2="176" style="stroke: rgba(235, 230, 216, 0.38);" />
    <line x1="693" y1="126" x2="693" y2="160" style="stroke: rgba(235, 230, 216, 0.38);" />
    <g style="fill: var(--bg-spruce); stroke-width: 2.5;" stroke="var(--accent)">
      {waypoints.map((point) => (
        <circle cx={point.x} cy={point.y} r="6" />
      ))}
    </g>
    <g style="font-family: var(--font-cond); font-weight: 600; font-size: 20px; fill: var(--bone); letter-spacing: 0.03em; text-transform: uppercase;">
      {waypoints.map((point, index) => {
        if (!point.label) return null;
        const offset = labelOffsets[index] ?? { dx: 0, dy: -34 };
        return (
          <text
            x={point.x + offset.dx}
            y={point.y + offset.dy}
            style={`text-anchor: ${point.labelAnchor};`}
          >
            {point.label}
          </text>
        );
      })}
    </g>
    <g style="font-family: var(--font-mono); font-size: 12px; fill: var(--mute); letter-spacing: 0.06em;">
      {waypoints.map((point, index) => {
        const isLast = index === waypoints.length - 1;
        const yearAnchor = index === 2 ? 'start' : point.labelAnchor;
        return (
          <text x={isLast ? 1280 : point.x} y="326" style={`text-anchor: ${yearAnchor};`}>
            {point.year}
          </text>
        );
      })}
      {waypoints
        .filter((point) => point.note)
        .map((point) => (
          <text x={point.x + 14} y={point.y - 18}>
            {point.note}
          </text>
        ))}
    </g>
  </svg>
</div>
