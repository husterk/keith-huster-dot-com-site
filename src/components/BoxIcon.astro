---
interface Props {
  name: 'helmet' | 'rack' | 'map';
}

const { name } = Astro.props;
---

<svg class="box-icon" viewBox="0 0 48 48" aria-hidden="true">
  {name === 'helmet' && (
    <>
      <path class="ink" d="M11 30 C11 18.5 17 11 24 11 C31 11 37 18.5 37 30" />
      <path
        class="ink"
        d="M16.5 28.5 C16.5 21.5 18.5 16.5 21 13.6 M31.5 28.5 C31.5 21.5 29.5 16.5 27 13.6"
      />
      <path
        class="ink"
        d="M3 31 C10 28 38 28 45 31 C43.5 35 37 37.5 24 37.5 C11 37.5 4.5 35 3 31 Z"
      />
      <path class="accent" d="M18 15.5 Q24 11.5 30 15.5 V23 L24 28.5 L18 23 Z" />
      <path class="cut" d="M20.8 17.3 Q24 15.4 27.2 17.3 V22 L24 25 L20.8 22 Z" />
    </>
  )}
  {name === 'rack' && (
    <>
      <rect class="ink" x="10" y="6" width="28" height="34" rx="2" />
      <path class="ink" d="M10 17 H38 M10 28 H38 M14 40 V43 M34 40 V43" />
      <path class="ink" d="M22 11.5 H33 M22 22.5 H33 M22 33.5 H33" />
      <circle class="accent" cx="15.5" cy="11.5" r="1.8" />
      <circle class="accent" cx="15.5" cy="22.5" r="1.8" />
      <circle class="dim" cx="15.5" cy="33.5" r="1.8" />
    </>
  )}
  {name === 'map' && (
    <>
      <path class="ink" d="M5 14 L17 10 L31 14 L43 10 V36 L31 40 L17 36 L5 40 Z" />
      <path class="ink" d="M17 10 V36 M31 14 V40" />
      <path class="route" d="M9 33 C14 27 19 32 23 26 C26 22 28 24 30 22" />
      <path
        class="accent"
        d="M34 29 C34 29 28 23 28 18.5 A6 6 0 0 1 40 18.5 C40 23 34 29 34 29 Z"
      />
      <circle class="cut-fill" cx="34" cy="18.5" r="2.2" />
    </>
  )}
</svg>

<style>
  .box-icon {
    width: 48px;
    height: 48px;
    flex: none;
    overflow: visible;
  }
  .ink {
    fill: none;
    stroke: var(--text-soft);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .accent {
    fill: var(--accent);
    stroke: none;
  }
  .cut {
    fill: none;
    stroke: var(--bg-desert);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cut-fill {
    fill: var(--bg-desert);
  }
  .dim {
    fill: var(--mute);
  }
  .route {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 2 3.5;
  }
</style>
