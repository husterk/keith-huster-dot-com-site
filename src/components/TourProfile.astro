---
interface Props {
  label: string;
  points: [number, number][];
  peaks: { mile: number; text: string; anchor: 'start' | 'middle' | 'end'; high: boolean }[];
  states: { from: number; short: string; name: string; color: string }[];
}

const { label, points, peaks, states } = Astro.props;

const W = 640;
const LEFT = 46;
const RIGHT = 632;
const TOP = 40;
const FLOOR = 450;
const BAND = 458;
const BAND_H = 18;
const MIN_FT = 2500;
const MAX_FT = 12500;
const miles = points[points.length - 1][0];

const x = (mile: number) => LEFT + ((RIGHT - LEFT) * mile) / miles;
const y = (ft: number) => FLOOR - ((FLOOR - TOP) * (ft - MIN_FT)) / (MAX_FT - MIN_FT);
const at = (mile: number) => points.find(([m]) => m === mile);

const line = points
  .map(([m, ft], i) => `${i ? 'L' : 'M'}${x(m).toFixed(1)},${y(ft).toFixed(1)}`)
  .join(' ');
const area = `${line} L${x(miles).toFixed(1)},${FLOOR} L${LEFT},${FLOOR} Z`;
const grid = [4000, 6000, 8000, 10000, 12000];
const ticks = [0, 500, 1000, 1500, 2000, 2500];
const bands = states.map((s, i) => {
  const end = states[i + 1]?.from ?? miles;
  const x0 = x(s.from);
  const width = x(end) - x0;
  return { ...s, x0, width, text: width > 70 ? s.name : s.short };
});
const labeled = peaks.map((peak) => {
  const point = at(peak.mile);
  if (!point) throw new Error(`Tour profile peak at mile ${peak.mile} has no matching point`);
  return { ...peak, px: x(point[0]), py: y(point[1]) };
});
---

<svg class="tour-profile" viewBox={`0 0 ${W} ${BAND + BAND_H + 26}`} role="img" aria-label={label}>
  <defs>
    <linearGradient id="tour-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--accent)" stop-opacity="0.34"></stop>
      <stop offset="1" stop-color="var(--accent)" stop-opacity="0.02"></stop>
    </linearGradient>
  </defs>
  <g class="tp-grid">
    {grid.map((ft) => (
      <>
        <line x1={LEFT} y1={y(ft)} x2={RIGHT} y2={y(ft)} />
        <text x={LEFT - 8} y={y(ft) + 3.5} text-anchor="end">
          {`${ft / 1000}K FT`}
        </text>
      </>
    ))}
  </g>
  <path class="tp-area" d={area} fill="url(#tour-fill)" />
  <path class="tp-line" d={line} />
  <line class="tp-floor" x1={LEFT} y1={FLOOR} x2={RIGHT} y2={FLOOR} />
  <g class="tp-bands">
    {bands.map((band) => (
      <>
        <rect x={band.x0} y={BAND} width={band.width} height={BAND_H} fill={band.color} />
        <text x={band.x0 + band.width / 2} y={BAND + 12.5} text-anchor="middle">
          {band.text}
        </text>
      </>
    ))}
  </g>
  <g class="tp-ticks">
    {ticks.map((mile) => (
      <text x={x(mile)} y={BAND + BAND_H + 16} text-anchor={mile === 0 ? 'start' : 'middle'}>
        {mile.toLocaleString('en-US')}
      </text>
    ))}
  </g>
  <g class="tp-peaks">
    {labeled.map((peak) => (
      <>
        <circle
          cx={peak.px}
          cy={peak.py}
          r={peak.high ? 5 : 3.5}
          class={peak.high ? 'tp-high' : ''}
        />
        <text
          x={peak.px + (peak.anchor === 'start' ? 9 : peak.anchor === 'end' ? -9 : 0)}
          y={peak.anchor === 'middle' ? peak.py - 11 : peak.py + 4}
          text-anchor={peak.anchor}
          class={peak.high ? 'tp-high' : ''}
        >
          {peak.text}
        </text>
      </>
    ))}
  </g>
</svg>

<style>
  .tour-profile {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .tp-grid line {
    stroke: rgba(235, 230, 216, 0.08);
  }
  .tp-grid text,
  .tp-ticks text {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    fill: var(--mute);
  }
  .tp-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .tp-floor {
    stroke: var(--line3);
  }
  .tp-bands rect {
    stroke: rgba(235, 230, 216, 0.18);
    stroke-width: 1;
  }
  .tp-bands text {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
    fill: var(--bone);
    text-transform: uppercase;
  }
  .tp-peaks circle {
    fill: var(--bg-desert);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .tp-peaks text {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    fill: var(--bone);
    paint-order: stroke;
    stroke: var(--bg-desert);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .tp-peaks text.tp-high {
    font-size: 15px;
    fill: var(--accent);
  }
  @media (max-width: 699px) {
    .tp-grid text,
    .tp-bands text,
    .tp-peaks text {
      display: none;
    }
    .tp-ticks text {
      display: none;
    }
  }
</style>
