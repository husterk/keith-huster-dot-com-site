---
import { getSite, getImpact } from '../lib/content';
import { linkify } from '../lib/links';

const site = await getSite();
const impact = await getImpact();
const copy = site.impact;
---

<section id="segments" class="section segments">
  <div class="stack">
    <div class="mono eyebrow">{copy.eyebrow}</div>
    <h2 class="cond h2">{copy.heading}</h2>
  </div>
  <ul class="rows">
    {impact.map((entry, index) => (
      <li class="row">
        <div class="num">
          {copy.segmentLabel} {String(index + 1).padStart(2, '0')}
        </div>
        <div class="t">{entry.title}</div>
        <p class="body" set:html={linkify(entry.body)} />
        <div class="res">
          <div class="n">{entry.result.value}</div>
          <div class="l">{entry.result.label}</div>
        </div>
      </li>
    ))}
  </ul>
  <ul class="chips">
    {site.chips.map((chip) => (
      <li>{chip}</li>
    ))}
  </ul>
</section>
