  <rect x="0" y="0" width="632" height="170.0" fill="#101d18" />
  <g>
    {states.map((state) => (
      <path
        d={state.d}
        fill={fills[state.name] ?? '#141a17'}
        stroke="rgba(235,230,216,.22)"
        stroke-width="1.2"
        stroke-linejoin="round"
      />
    ))}
  </g>
  <line
