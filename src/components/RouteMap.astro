---
import { feature } from 'topojson-client';
import type { Topology, GeometryCollection } from 'topojson-specification';
import type { Feature, MultiPolygon, Polygon } from 'geojson';
import statesTopology from 'us-atlas/states-10m.json';
import { getColophon } from '../lib/content';

const { map } = await getColophon();
const className = { place: 'lbl', big: 'lbl-big', mile: 'mile' } as const;

// Same equirectangular projection the route and labels use: 49°N sits on the border line at y=170.
const project = ([lon, lat]: number[]) => [276.8 + (lon + 111.05) * 37.16, 170 + (49 - lat) * 50];
const fills: Record<string, string> = {
  Montana: 'var(--bg-lake)',
  Idaho: 'var(--bg-basin)',
  Wyoming: 'var(--bg-basin)',
  Colorado: 'var(--bg-alpine)',
  'New Mexico': 'var(--bg-desert)',
};
const FRAME = { left: -10, right: 642, top: 160, bottom: 1100 };
// Sutherland-Hodgman against each frame edge; the parts of a state outside the frame never ship.
const clip = (ring: number[][]) => {
  const edges: [(p: number[]) => boolean, (a: number[], b: number[]) => number[]][] = [
    [(p) => p[0] >= FRAME.left, (a, b) => at(a, b, 0, FRAME.left)],
    [(p) => p[0] <= FRAME.right, (a, b) => at(a, b, 0, FRAME.right)],
    [(p) => p[1] >= FRAME.top, (a, b) => at(a, b, 1, FRAME.top)],
    [(p) => p[1] <= FRAME.bottom, (a, b) => at(a, b, 1, FRAME.bottom)],
  ];
  return edges.reduce((points, [inside, cross]) => {
    const out: number[][] = [];
    points.forEach((current, i) => {
      const previous = points[(i + points.length - 1) % points.length];
      if (inside(current)) {
        if (!inside(previous)) out.push(cross(previous, current));
        out.push(current);
      } else if (inside(previous)) out.push(cross(previous, current));
    });
    return out;
  }, ring);
};
const at = (a: number[], b: number[], axis: number, value: number) => {
  const t = (value - a[axis]) / (b[axis] - a[axis]);
  return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
};
const topology = statesTopology as unknown as Topology<{ states: GeometryCollection }>;
const states = (
  feature(topology, topology.objects.states).features as Feature<
    Polygon | MultiPolygon,
    { name: string }
  >[]
)
  .map((state) => {
    const polygons =
      state.geometry.type === 'Polygon' ? [state.geometry.coordinates] : state.geometry.coordinates;
    const rings = polygons.flat().map((ring) => {
      const points: number[][] = [];
      for (const point of clip(ring.map(project))) {
        const last = points.at(-1);
        if (!last || Math.hypot(point[0] - last[0], point[1] - last[1]) > 2) points.push(point);
      }
      return points;
    });
    const xs = rings.flat().map((p) => p[0]);
    const ys = rings.flat().map((p) => p[1]);
    const visible =
      Math.max(...xs) > 0 &&
      Math.min(...xs) < 632 &&
      Math.max(...ys) > 170 &&
      Math.min(...ys) < 1090;
    const d = rings
      .filter((ring) => ring.length > 2)
      .map((ring) => `M${ring.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L')}Z`)
      .join('');
    return { name: state.properties.name, d, visible };
  })
  .filter((state) => state.visible);
---

