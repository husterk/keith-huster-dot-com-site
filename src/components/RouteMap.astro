<style is:global>
  .route-map {
    display: block;
    width: 100%;
    height: auto;
  }
  .route-map .lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--bone);
    paint-order: stroke;
    stroke: var(--bg-spruce);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .route-map .lbl-big {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    fill: var(--bone);
    paint-order: stroke;
    stroke: var(--bg-spruce);
    stroke-width: 6px;
    stroke-linejoin: round;
  }
  .route-map .mile {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    fill: var(--mute);
    paint-order: stroke;
    stroke: var(--bg-spruce);
    stroke-width: 4px;
  }
</style>
