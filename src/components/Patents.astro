---
import { getPatents, getResume } from '../lib/content';
import { linkify } from '../lib/links';

const patents = await getPatents();
const { education } = await getResume();
---

<section id="patents" class="section patents">
  <div class="big36" aria-hidden="true">
    {patents.bigNumber}
  </div>
  <div class="right">
    <div class="mono eyebrow">{patents.eyebrow}</div>
    <h2 class="cond h2">{patents.heading}</h2>
    {patents.paragraphs.map((paragraph) => (
      <p class="lead" set:html={linkify(paragraph)} />
    ))}
    <div class="edu">
      {education.map((e) => (
        <span>
          {e.degree} · {e.school}
        </span>
      ))}
    </div>
  </div>
</section>
