---
interface Props {
  name: 'lake' | 'basin' | 'pass' | 'nm' | 'finish' | 'fork';
  h: number;
  background: string;
}

const { name, h, background } = Astro.props;
---

<div class={`strip ${name}`} style={`--h: ${h}px; background: ${background}`}>
  <slot />
</div>

<style is:global>
  .strip {
    position: relative;
    overflow: hidden;
    height: calc(var(--h) * var(--k));
    line-height: 0;
    --cx: 720px;
  }

  .scene {
    position: absolute;
    bottom: 0;
    left: calc(50% - var(--cx) * var(--k));
    width: 1440px;
    height: var(--h);
    transform: scale(var(--k));
    transform-origin: 0 100%;
    pointer-events: none;
  }

  .finish {
    position: relative;
    overflow: hidden;
    height: calc(var(--h) * var(--k));
    margin: 0 calc(var(--pad) * -1);
    --cx: 720px;
  }

  html.rides .strip .rider[data-rides]:not(.placed) {
    visibility: hidden;
  }

  .lbl {
    fill: var(--bone);
    paint-order: stroke;
    stroke: rgba(14, 24, 20, 0.75);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  @media (max-width: 1099px) {
    .lbl {
      display: none;
    }

    .strip.lake,
    .strip.basin,
    .strip.pass,
    .strip.nm,
    .finish {
      --cx: 720px;
    }
  }

  @media (max-width: 699px) {
    .strip.lake {
      --cx: 330px;
    }

    .strip.basin {
      --cx: 860px;
    }

    .strip.pass {
      --cx: 640px;
    }

    .strip.nm {
      --cx: 1000px;
    }

    .finish {
      --cx: 1080px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rider > * {
      animation: bob 1.6s ease-in-out alternate infinite;
    }
  }

  @keyframes bob {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -2px;
    }
  }
</style>

<script>
  const STEP = 6;
  const HIP: [number, number] = [37, 20];
  const CRANK: [number, number] = [44, 54];
  const CRANK_RADIUS = 8;
  const LIMB = 20;
  const PEDAL_PITCH = 22;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<SVGSVGElement>('.scene').forEach((scene) => {
    const rider = scene.querySelector<SVGGElement>('.rider[data-rides]');
    const container = scene.parentElement;
    if (reduced || !rider || !container) return;
    const isHero = container.classList.contains('hero');
    const TRAVEL = isHero ? 220 : 150;
    const legs = rider.querySelectorAll<SVGPathElement>('.leg');
    const legPath = (theta: number) => {
      const fx = CRANK[0] + CRANK_RADIUS * Math.cos(theta);
      const fy = CRANK[1] + CRANK_RADIUS * Math.sin(theta);
      const vx = fx - HIP[0];
      const vy = fy - HIP[1];
      const d = Math.min(Math.hypot(vx, vy), 2 * LIMB - 0.01);
      const ux = vx / d;
      const uy = vy / d;
      const h = Math.sqrt(LIMB * LIMB - (d / 2) ** 2);
      const mx = HIP[0] + (ux * d) / 2;
      const my = HIP[1] + (uy * d) / 2;
      const kx = mx - uy * h > mx + uy * h ? mx - uy * h : mx + uy * h;
      const ky = mx - uy * h > mx + uy * h ? my + ux * h : my - ux * h;
      return `M${HIP[0]},${HIP[1]} L${kx.toFixed(1)},${ky.toFixed(1)} L${fx.toFixed(1)},${fy.toFixed(1)}`;
    };
    const start = /translate\(([-\d.]+),([-\d.]+)\)\s*rotate\([-\d.]+\)\s*scale\(([-\d.]+)\)/.exec(
      rider.getAttribute('transform') ?? '',
    );
    if (!start) return;
    const x0 = Number(rider.dataset.x0 ?? start[1]);
    const y0 = Number(rider.dataset.y0 ?? start[2]);
    const scale = start[3];
    const point = scene.createSVGPoint();
    const base = (rider.parentNode as SVGGraphicsElement).getCTM() ?? scene.createSVGMatrix();
    const inside = (shape: SVGGeometryElement, x: number, y: number) => {
      point.x = x;
      point.y = y;
      const toShape = (shape.getCTM() ?? scene.createSVGMatrix()).inverse().multiply(base);
      return shape.isPointInFill(point.matrixTransform(toShape));
    };

    let track: [number, number][] | null = null;
    const buildTrack = () => {
      const shapes = [...scene.querySelectorAll<SVGGeometryElement>('path, rect')].filter(
        (shape) => !shape.closest('.rider') && typeof shape.isPointInFill === 'function',
      );
      const ground = shapes.filter((shape) => inside(shape, x0, y0 + 3)).pop();
      if (!ground) return;
      const samples: [number, number][] = [];
      for (let x = x0 - TRAVEL; x <= x0 + TRAVEL; x += STEP) {
        let y = y0 - 220;
        while (y < y0 + 150 && !inside(ground, x, y)) y += 2;
        samples.push([x, y]);
      }
      const screen = scene.getScreenCTM();
      const box = container.getBoundingClientRect();
      const toScreen = screen ? screen.multiply(base) : base;
      const toScreenX = (x: number) => x * toScreen.a + toScreen.e;
      const halfWidth = 70 * Number(scale) * toScreen.a;
      const visible = (x: number) =>
        toScreenX(x) - halfWidth >= box.left + 8 && toScreenX(x) + halfWidth <= box.right - 8;
      const origin = Math.round(TRAVEL / STEP);
      let lo = origin;
      let hi = origin;
      while (
        lo > 0 &&
        Math.abs(samples[lo - 1][1] - samples[lo][1]) <= 14 &&
        visible(samples[lo - 1][0])
      )
        lo--;
      while (
        hi < samples.length - 1 &&
        Math.abs(samples[hi + 1][1] - samples[hi][1]) <= 14 &&
        visible(samples[hi + 1][0])
      )
        hi++;
      track = samples.slice(lo, hi + 1);
    };

    const place = (progress: number) => {
      if (!track) buildTrack();
      if (!track) return;
      const first = track[0][0];
      const last = track[track.length - 1][0];
      const x = first + progress * (last - first);
      const i = Math.min(track.length - 2, Math.max(0, Math.floor((x - first) / STEP)));
      const [xa, ya] = track[i];
      const [xb, yb] = track[i + 1];
      const y = ya + ((yb - ya) * (x - xa)) / (xb - xa);
      const a = track[Math.max(0, i - 4)];
      const b = track[Math.min(track.length - 1, i + 5)];
      const angle = (Math.atan2(b[1] - a[1], b[0] - a[0]) * 180) / Math.PI;
      rider.setAttribute(
        'transform',
        `translate(${x.toFixed(1)},${y.toFixed(1)}) rotate(${angle.toFixed(1)}) scale(${scale}) translate(-48,-69)`,
      );
      rider.classList.add('placed');
      const theta = (x - first) / PEDAL_PITCH - Math.PI / 4;
      legs.forEach((leg) =>
        leg.setAttribute('d', legPath(leg.classList.contains('far') ? theta + Math.PI : theta)),
      );
    };

    let exitScroll = 0;
    const progress = () => {
      const rect = container.getBoundingClientRect();
      if (isHero) {
        if (!exitScroll) exitScroll = rider.getBoundingClientRect().bottom + scrollY;
        return Math.min(1, scrollY / exitScroll);
      }
      return Math.min(1, Math.max(0, (innerHeight - rect.top) / (innerHeight + rect.height)));
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        place(progress());
      });
    };
    addEventListener('resize', () => {
      track = null;
    });
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      } else {
        removeEventListener('scroll', onScroll);
      }
    }).observe(container);
  });
</script>
