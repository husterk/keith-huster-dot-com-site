---
interface Props {
  name: 'lake' | 'basin' | 'pass' | 'nm' | 'finish';
  h: number;
  background: string;
}

const { name, h, background } = Astro.props;
---

<div class={`strip ${name}`} style={`--h: ${h}px; background: ${background}`}>
  <slot />
</div>

<style is:global>
  .strip {
    position: relative;
    overflow: hidden;
    height: calc(var(--h) * var(--k));
    line-height: 0;
    --cx: 720px;
  }

  .scene {
    position: absolute;
    bottom: 0;
    left: calc(50% - var(--cx) * var(--k));
    width: 1440px;
    height: var(--h);
    transform: scale(var(--k));
    transform-origin: 0 100%;
    pointer-events: none;
  }

  .finish {
    position: relative;
    overflow: hidden;
    height: calc(var(--h) * var(--k));
    margin: auto calc(var(--pad) * -1) 0;
    --cx: 720px;
  }

  @media (max-width: 1099px) {
    .lbl {
      display: none;
    }

    .strip.lake,
    .strip.basin,
    .strip.pass,
    .strip.nm,
    .finish {
      --cx: 720px;
    }
  }

  @media (max-width: 699px) {
    .strip.lake {
      --cx: 330px;
    }

    .strip.basin {
      --cx: 860px;
    }

    .strip.pass {
      --cx: 640px;
    }

    .strip.nm {
      --cx: 1000px;
    }

    .finish {
      --cx: 1080px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rider > * {
      animation: bob 1.6s ease-in-out alternate infinite;
    }
  }

  @keyframes bob {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -2px;
    }
  }
</style>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGElement>('.scene').forEach((scene) => {
      const riders = scene.querySelectorAll<SVGElement>('.rider');
      if (!riders.length) return;

      let queued = false;
      const apply = () => {
        queued = false;
        const rect = scene.getBoundingClientRect();
        const center = rect.top + rect.height / 2 - innerHeight / 2;
        const offset = Math.max(-10, Math.min(10, -center * 0.05));
        riders.forEach((rider) => (rider.style.translate = `0 ${offset}px`));
      };
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(apply);
      };

      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        } else {
          removeEventListener('scroll', onScroll);
        }
      }).observe(scene);
    });
  }
</script>
