---
import { getLeadership } from '../lib/content';
import { linkify } from '../lib/links';

const leadership = await getLeadership();
---

<section id="crew" class="section crew">
  <div class="left">
    <div class="mono eyebrow">{leadership.eyebrow}</div>
    <h2 class="cond h2">{leadership.heading}</h2>
    {leadership.paragraphs.map((paragraph) => (
      <p class="lead" set:html={linkify(paragraph)} />
    ))}
  </div>
  <ul class="grid2">
    {leadership.cells.map((cell) => (
      <li class="cell">
        <div class="n">{cell.value}</div>
        <div class="l">{cell.label}</div>
      </li>
    ))}
  </ul>
</section>
