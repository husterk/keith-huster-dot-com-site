---
import { getSite } from '../lib/content';

const { turnstileSiteKey, links, form: copy } = await getSite();
---

<form class="contact-form" method="post" action="/api/contact" novalidate data-contact-form>
  <div class="field">
    <label class="mono" for="contact-name">
      {copy.name}
    </label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100" />
  </div>
  <div class="field">
    <label class="mono" for="contact-email">
      {copy.email}
    </label>
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      maxlength="254"
    />
  </div>
  <div class="field wide">
    <label class="mono" for="contact-message">
      {copy.message}
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      minlength="10"
      maxlength="3000"
    ></textarea>
  </div>
  <div class="trap" aria-hidden="true">
    <label for="contact-company">{copy.company}</label>
    <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
  <div class="actions">
    <button class="btn primary" type="submit">
      {copy.submit}
    </button>
    <p class="status mono" role="status" aria-live="polite" data-status></p>
    <button class="btn ghost" type="button" data-retry hidden>
      {copy.retry}
    </button>
  </div>
  <p class="fallback body" data-fallback hidden>
    {copy.fallback} <a href={`mailto:${links.email}`}>{links.email}</a>.
  </p>
</form>
<script type="application/json" id="contact-copy" set:html={JSON.stringify(copy.messages)}></script>
<script>
  type Turnstile = {
    render: (el: Element, options: Record<string, unknown>) => string;
    reset: (id?: string) => void;
    getResponse: (id?: string) => string | undefined;
  };
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const copy = JSON.parse(document.getElementById('contact-copy')?.textContent ?? '{}') as Record<
    string,
    string
  >;
  if (form) {
    let done = false;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const fallback = form.querySelector<HTMLElement>('[data-fallback]')!;
    const retry = form.querySelector<HTMLButtonElement>('[data-retry]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const widget = form.querySelector<HTMLElement>('.cf-turnstile')!;
    let widgetId: string | undefined;
    let token = '';
    let loadTimer: number | undefined;
    let pending: ((value: string) => void) | undefined;
    const waitForToken = () =>
      new Promise<string>((resolve) => {
        pending = resolve;
        window.setTimeout(() => {
          if (pending === resolve) {
            pending = undefined;
            resolve('');
          }
        }, 12000);
      });

    const note = (text: string, showRetry = false) => {
      status.textContent = text;
      retry.hidden = !showRetry;
      fallback.hidden = !showRetry;
    };
    const renderWidget = () => {
      const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
      if (!turnstile) return;
      token = '';
      clearTimeout(loadTimer);
      loadTimer = window.setTimeout(() => {
        if (!token) note(copy.slow, true);
      }, 15000);
      widgetId = turnstile.render(widget, {
        sitekey: widget.dataset.sitekey,
        theme: 'dark',
        size: 'flexible',
        appearance: 'interaction-only',
        'before-interactive-callback': () => widget.classList.add('interactive'),
        'after-interactive-callback': () => widget.classList.remove('interactive'),
        callback: (value: string) => {
          token = value;
          clearTimeout(loadTimer);
          if (status.textContent && !done) note('');
          pending?.(value);
          pending = undefined;
        },
        'error-callback': (code: string) => {
          token = '';
          clearTimeout(loadTimer);
          note(copy.failed.replace('{code}', code), true);
          return true;
        },
        'expired-callback': () => {
          token = '';
          note(copy.expired, true);
        },
        'timeout-callback': () => {
          token = '';
          note(copy.timedOut, true);
        },
      });
    };
    (window as unknown as { onTurnstileReady?: () => void }).onTurnstileReady = renderWidget;

    const loadTurnstile = () => {
      if (document.querySelector('script[data-turnstile]')) return;
      const script = document.createElement('script');
      script.src =
        'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileReady&render=explicit';
      script.async = true;
      script.dataset.turnstile = '';
      script.onerror = () => note(copy.scriptFailed, true);
      document.head.appendChild(script);
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            loadTurnstile();
            observer.disconnect();
          }
        },
        { rootMargin: '600px' },
      );
      observer.observe(form);
    } else {
      loadTurnstile();
    }
    form.addEventListener('focusin', loadTurnstile, { once: true });

    retry.addEventListener('click', () => {
      const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
      note(copy.retrying);
      if (turnstile && widgetId !== undefined) {
        token = '';
        turnstile.reset(widgetId);
        clearTimeout(loadTimer);
        loadTimer = window.setTimeout(() => {
          if (!token) note(copy.stillNoAnswer, true);
        }, 15000);
      } else {
        loadTurnstile();
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
      let current = token || (widgetId !== undefined ? turnstile?.getResponse(widgetId) : '') || '';
      if (!current && turnstile && widgetId !== undefined && retry.hidden) {
        button.disabled = true;
        note(copy.checking);
        current = await waitForToken();
        button.disabled = false;
      }
      if (!current) {
        note(turnstile ? copy.notFinished : copy.neverLoaded, true);
        return;
      }
      button.disabled = true;
      note(copy.sending);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const data = (await response.json()) as { ok: boolean; message: string };
        if (data.ok) {
          done = true;
          note(data.message);
          form.reset();
          form
            .querySelectorAll('input, textarea')
            .forEach((el) => ((el as HTMLInputElement).disabled = true));
        } else {
          note(data.message, true);
          button.disabled = false;
          token = '';
          if (widgetId !== undefined) turnstile?.reset(widgetId);
        }
      } catch {
        note(copy.sendFailed, true);
        button.disabled = false;
      }
    });
  }
</script>
