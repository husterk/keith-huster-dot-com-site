---
import { getBeyond } from '../lib/content';
import { linkify } from '../lib/links';
import TourProfile from './TourProfile.astro';
import BoxIcon from './BoxIcon.astro';

const beyond = await getBeyond();
const { feature, boxes } = beyond;
---

<section id="offclock" class="section off">
  <div class="stack">
    <div class="mono eyebrow">{beyond.eyebrow}</div>
    <h2 class="cond h2">{beyond.heading}</h2>
  </div>
  <div class="grid">
    <div class="panel">
      <div class="box-head">
        <BoxIcon name={feature.icon} />
        <div class="box-name">
          <div class="mono muted" style="font-size: 12px;">
            {feature.caption}
          </div>
          <div class="t">{feature.title}</div>
        </div>
      </div>
      <p class="body" set:html={linkify(feature.body)} />
      <TourProfile {...feature.profile} />
      <div
        class="mono muted"
        style="font-size: 12px; display: flex; justify-content: space-between;"
      >
        <span>{feature.from}</span>
        <span>{feature.to}</span>
      </div>
    </div>
    <ul class="side">
      {boxes.map((box) => (
        <li class="box">
          <div class="box-head">
            <BoxIcon name={box.icon} />
            <div class="box-name">
              <div class="mono muted" style="font-size: 12px;">
                {/^[a-z0-9.-]+\.[a-z]{2,}(\/\S*)?$/i.test(box.caption) ? (
                  <a href={`https://${box.caption}`} target="_blank" rel="noopener">
                    {box.caption}
                  </a>
                ) : (
                  box.caption
                )}
              </div>
              <div class="t">{box.title}</div>
            </div>
          </div>
          <div class="d" set:html={linkify(box.body)} />
        </li>
      ))}
    </ul>
  </div>
</section>
