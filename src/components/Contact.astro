---
import { getSite } from '../lib/content';
import ContactForm from './ContactForm.astro';

const site = await getSite();
const { contact, links, footer } = site;
---

<section id="contact" class="contact">
  <div class="stack" style="gap: 32px;">
    <div class="mono eyebrow">{contact.eyebrow}</div>
    <h2 class="cond h2">{contact.heading}</h2>
    <div class="btns">
      <a href={`mailto:${links.email}`} class="btn primary">
        {links.email}
      </a>
      <a href={links.linkedin} class="btn ghost">
        LinkedIn
      </a>
      <a href={links.github} class="btn ghost">
        GitHub
      </a>
    </div>
    <ContactForm />
  </div>
  <footer class="foot">
    <span>{footer}</span>
    <span>
      <a href="/colophon">How this site was built</a> · © 2026
    </span>
  </footer>
  <slot name="scene" />
</section>
