---
import { getSite } from '../lib/content';
import ContactForm from './ContactForm.astro';
import Footer from './Footer.astro';

const site = await getSite();
const { contact, links } = site;
---

<section id="contact" class="contact">
  <div class="contact-grid">
    <div class="stack" style="gap: 32px;">
      <div class="mono eyebrow">{contact.eyebrow}</div>
      <h2 class="cond h2">{contact.heading}</h2>
      <div class="btns">
        <a href={`mailto:${links.email}`} class="btn primary">
          {links.email}
        </a>
        <a href={links.linkedin} class="btn ghost" target="_blank" rel="noopener">
          {contact.linkedinLabel}
        </a>
        <a href={links.github} class="btn ghost" target="_blank" rel="noopener">
          {contact.githubLabel}
        </a>
      </div>
    </div>
    <div class="form-col">
      <p class="mono muted form-intro">{contact.formIntro}</p>
      <ContactForm />
    </div>
  </div>
  <slot name="scene" />
  <Footer />
</section>
