---
import { getExperience, getSite } from '../lib/content';
import { linkify } from '../lib/links';
import ElevationChart from './ElevationChart.astro';

const experience = await getExperience();
const { experience: copy } = await getSite();
---

<section id="route" class="section route">
  <div class="head">
    <div class="stack">
      <div class="mono eyebrow">{copy.eyebrow}</div>
      <h2 class="cond h2">{copy.heading}</h2>
    </div>
    <p class="body">{copy.intro}</p>
  </div>
  <ElevationChart />
  <ul class="cards">
    {experience.map((role) => (
      <li class={`card${role.current ? ' now' : ''}`}>
        <div class="mono muted" style="font-size: 12px;">
          {role.dates}
        </div>
        <div class="t">{role.cardTitle}</div>
        <div class="d" set:html={linkify(role.summary)} />
      </li>
    ))}
  </ul>
</section>
