---
import { getSite } from '../lib/content';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { headScript, unregisterServiceWorkers } from '../lib/inline-scripts.mjs';
import '@fontsource/barlow-condensed/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/spline-sans-mono/latin-400.css';
import '@fontsource/spline-sans-mono/latin-500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sections.css';
import condensed700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/og.png', noindex = false } = Astro.props;
const site = await getSite();
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0e1814" />
    <link rel="preload" href={condensed700} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Reliable by design. A bikepacker on a ridge above Banff."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <slot name="head" />
    <GoogleAnalytics />
    <script is:inline set:html={headScript}></script>
  </head>
  <body>
    <a class="skip" href="#main">
      {site.nav.skip}
    </a>
    <script is:inline set:html={unregisterServiceWorkers}></script>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: var(--bg-border);
  }
  body {
    font-family: var(--font-body);
    color: var(--bone);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: var(--bone);
  }
  a:hover {
    color: #ff8a3c;
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    padding: 12px 16px;
    background: var(--accent);
    color: var(--dark-on-accent);
    z-index: 10;
  }
  .skip:focus {
    left: 0;
  }
</style>
