---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Strip from '../components/scenes/Strip.astro';
import PassColorado from '../components/scenes/PassColorado.astro';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
const updated = page.data.updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${page.data.title} · Keith Huster`} description={page.data.description}>
  <Nav />
  <Strip name="pass" h={420} background="var(--bg-spruce)">
    <PassColorado />
  </Strip>
  <main id="main" class="page">
    <article class="prose">
      <p class="mono eyebrow">Colophon</p>
      <h1 class="cond">{page.data.title}</h1>
      <Content />
      <p class="mono muted updated">Updated {updated}</p>
    </article>
  </main>
  <footer class="foot page-foot">
    <span>
      <a href="/">Back to the site</a>
    </span>
    <span>© 2026</span>
  </footer>
</Base>

<style>
  .page {
    background: var(--bg-alpine);
    padding: 80px var(--pad) 64px;
  }
  .prose {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-body);
  }
  .prose h1 {
    font-size: clamp(44px, 6vw, 88px);
    line-height: 0.95;
    margin: 0 0 12px;
    color: var(--bone);
    text-wrap: balance;
  }
  .prose :global(h2) {
    font-family: var(--font-cond);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 36px;
    line-height: 1;
    margin: 32px 0 0;
    color: var(--bone);
  }
  .prose :global(p) {
    margin: 0;
    text-wrap: pretty;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--bone);
  }
  .prose :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 15px;
    line-height: 1.45;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 12px 16px 12px 0;
    border-top: 1px solid var(--line);
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
    border-top: 0;
  }
  .prose :global(tr:last-child td) {
    border-bottom: 1px solid var(--line);
  }
  .prose :global(strong) {
    color: var(--bone);
    font-weight: 600;
  }
  .updated {
    margin-top: 24px;
  }
  .page-foot {
    background: var(--bg-spruce);
    padding: 24px var(--pad);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 699px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
