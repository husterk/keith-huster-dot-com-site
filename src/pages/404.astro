---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Strip from '../components/scenes/Strip.astro';
import ForkInTheRoad from '../components/scenes/ForkInTheRoad.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const { notFound, footerLinks } = site;
const year = new Date().getFullYear();
---

<Base title={`${notFound.title} · ${site.name}`} description={notFound.description} noindex>
  <Nav />
  <main id="main">
    <section class="section off-route">
      <p class="mono eyebrow">{notFound.eyebrow}</p>
      <h1 class="cond">{notFound.heading}</h1>
      <p class="body">{notFound.body}</p>
      <a class="btn primary" href="/">
        {notFound.cta}
      </a>
    </section>
    <Strip name="fork" h={360} background="var(--bg-alpine)">
      <ForkInTheRoad />
    </Strip>
  </main>
  <footer class="foot page-foot">
    <span>
      <a href="/">{footerLinks.back}</a>
    </span>
    <span>© {year}</span>
  </footer>
</Base>

<style is:global>
  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  body > main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>

<style>
  .off-route {
    background: var(--bg-alpine);
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 12px;
    padding-top: 40px;
    padding-bottom: 24px;
  }
  .off-route h1 {
    font-size: clamp(56px, 6vw, 96px);
    margin: 0;
  }
  .off-route .body {
    max-width: 440px;
  }
  .page-foot {
    background: var(--bg-alpine);
    padding: 24px var(--pad);
    border-top: 1px solid var(--line);
  }
</style>
