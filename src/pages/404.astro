---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Strip from '../components/scenes/Strip.astro';
import ForkInTheRoad from '../components/scenes/ForkInTheRoad.astro';
---

<Base title="Not found · Keith Huster" description="That page does not exist.">
  <Nav />
  <main id="main">
    <section class="section off-route">
      <p class="mono eyebrow">404</p>
      <h1 class="cond">Off route.</h1>
      <p class="body">That page is not on the map. Head back to the trailhead.</p>
      <a class="btn primary" href="/">
        Back to the trail
      </a>
    </section>
    <Strip name="fork" h={360} background="var(--bg-alpine)">
      <ForkInTheRoad />
    </Strip>
  </main>
  <footer class="foot page-foot">
    <span>
      <a href="/">Back to the site</a>
    </span>
    <span>© 2026</span>
  </footer>
</Base>

<style>
  .off-route {
    background: var(--bg-alpine);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .off-route h1 {
    font-size: clamp(56px, 8vw, 112px);
    margin: 0;
  }
  .off-route .body {
    max-width: 440px;
  }
  .page-foot {
    background: var(--bg-alpine);
    padding: 24px var(--pad);
    border-top: 1px solid var(--line);
  }
</style>
