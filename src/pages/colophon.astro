---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import RouteMap from '../components/RouteMap.astro';
import { getColophon, getSite } from '../lib/content';
import { linkify } from '../lib/links';

const c = await getColophon();
const site = await getSite();
const year = new Date().getFullYear();
const updated = c.updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const repoLabel = c.repo.replace(/^https?:\/\//, '');
---

<Base title={`${c.title} · ${site.name}`} description={c.description}>
  <Nav />
  <main id="main" class="colophon">
    <div class="layout">
      <aside class="rail" aria-label={c.map.label}>
        <RouteMap />
        <p class="mono muted rail-note">{c.map.railNote}</p>
      </aside>
      <article class="content">
        <p class="mono eyebrow">{c.eyebrow}</p>
        <h1 class="cond">{c.title}</h1>
        <p class="lead">
          {c.intro} {c.sourceNote}{' '}
          <a href={c.repo} target="_blank" rel="noopener">
            {repoLabel}
          </a>
          .
        </p>
        <p class="summary">{c.summary}</p>

        <ul class="tiles" aria-label={c.statsLabel}>
          {c.stats.map((s) => (
            <li class="tile">
              <span class="n">{s.value}</span>
              <span class="l">{s.label}</span>
            </li>
          ))}
        </ul>

        <section class="block">
          <h2 class="cond h2">
            <span aria-hidden="true">{c.sections.kit.emoji}</span> {c.sections.kit.title}
          </h2>
          <ul class="kit">
            {c.kit.map((k) => (
              <li class="k">
                <span class="k-emoji" aria-hidden="true">
                  {k.emoji}
                </span>
                <span class="mono muted w">{k.label}</span>
                <span class="t" set:html={linkify(k.title)} />
                <span class="d" set:html={linkify(k.why)} />
              </li>
            ))}
          </ul>
        </section>

        <section class="block">
          <h2 class="cond h2">
            <span aria-hidden="true">{c.sections.decisions.emoji}</span>{' '}
            {c.sections.decisions.title}
          </h2>
          <dl class="dec">
            {c.decisions.map((d) => (
              <>
                <dt class="q">
                  <span aria-hidden="true">{d.emoji}</span> {d.title}
                </dt>
                <dd set:html={linkify(d.body)} />
              </>
            ))}
          </dl>
        </section>

        <section class="block">
          <h2 class="cond h2">
            <span aria-hidden="true">{c.sections.route.emoji}</span> {c.sections.route.title}
          </h2>
          <p class="body theme" set:html={linkify(c.themeNote)} />
          <ol class="legend">
            {c.legend.map((l) => (
              <li style={`background: ${l.color}`}>
                <span aria-hidden="true">{l.emoji}</span>
                <span class="place">{l.place}</span>
                <span class="mono muted sec">{l.section}</span>
              </li>
            ))}
          </ol>
        </section>

        <section class="block">
          <h2 class="cond h2">
            <span aria-hidden="true">{c.sections.credits.emoji}</span> {c.sections.credits.title}
          </h2>
          <p class="body" set:html={linkify(c.credits)} />
          <p class="mono muted updated">
            {c.updatedLabel} {updated}
          </p>
        </section>
      </article>
    </div>
  </main>
  <footer class="foot page-foot">
    <span>
      <a href="/">{site.footerLinks.back}</a>
    </span>
    <span>© {year}</span>
  </footer>
</Base>

<style>
  .colophon {
    background: var(--bg-spruce);
    padding: 72px var(--pad) 64px;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(340px, 34%) minmax(0, 1fr);
    gap: clamp(48px, 5vw, 96px);
    align-items: start;
  }
  .rail {
    position: sticky;
    top: 120px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rail-note {
    font-size: 11px;
    line-height: 1.5;
    text-transform: none;
    letter-spacing: 0.04em;
    max-width: var(--measure);
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .theme {
    max-width: var(--measure);
    margin: 0 0 20px;
  }
  .content h1 {
    font-size: clamp(44px, 6vw, 88px);
    line-height: 0.95;
    margin: 0;
    text-wrap: balance;
  }
  .content .h2 {
    font-size: 40px;
    margin: 0 0 20px;
  }
  .lead {
    color: var(--text-soft);
    font-size: 19px;
    line-height: 1.6;
    margin: 0;
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .lead a {
    color: var(--accent);
  }
  .summary {
    margin: 0;
    color: var(--text-body);
    font-size: 17px;
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .tiles {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line2);
  }
  .tile {
    padding: 20px 20px 0;
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tile:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .tile .n {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 48px;
    line-height: 1;
  }
  .tile .l {
    color: var(--mute);
    font-size: 14px;
    line-height: 1.4;
  }
  .block {
    margin-top: 32px;
  }
  .kit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
  }
  .k {
    border: 1px solid var(--line2);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
  }
  .k-emoji {
    font-size: 22px;
    line-height: 1;
    margin-bottom: 4px;
  }
  .k .w {
    font-size: 11px;
  }
  .k .t {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 24px;
    line-height: 1;
    text-transform: uppercase;
  }
  .k .t :global(a) {
    color: inherit;
    text-decoration: none;
  }
  .k .t :global(a:hover) {
    color: var(--accent);
  }
  .k .d {
    color: var(--text-body);
    font-size: 15px;
    line-height: 1.5;
  }
  .dec {
    margin: 0;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 0 40px;
    align-items: start;
  }
  .dec dt,
  .dec dd {
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .dec dt:first-of-type,
  .dec dd:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .dec .q {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 26px;
    line-height: 1;
    text-transform: uppercase;
  }
  .dec dd {
    margin: 0;
    color: var(--text-body);
    font-size: 16px;
    line-height: 1.55;
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border: 1px solid var(--line2);
  }
  .legend li {
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-left: 1px solid var(--line2);
    font-size: 15px;
  }
  .legend li:first-child {
    border-left: 0;
  }
  .legend .place {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 20px;
    text-transform: uppercase;
    line-height: 1;
  }
  .legend .sec {
    font-size: 11px;
  }
  .updated {
    margin: 16px 0 0;
  }
  .page-foot {
    background: var(--bg-spruce);
    padding: 24px var(--pad);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 1099px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .rail {
      position: static;
      order: 2;
      max-width: 520px;
    }
    .kit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .legend {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .legend li:nth-child(4) {
      border-left: 0;
    }
    .legend li:nth-child(n + 4) {
      border-top: 1px solid var(--line2);
    }
  }
  @media (max-width: 699px) {
    .colophon {
      padding: 48px var(--pad) 48px;
    }
    .content .h2 {
      font-size: 32px;
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile {
      padding: 16px 12px 16px;
      border-top: 0;
    }
    .tile:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .tile:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .tile .n {
      font-size: 36px;
    }
    .kit {
      grid-template-columns: 1fr;
    }
    .dec {
      grid-template-columns: 1fr;
    }
    .dec dt {
      padding-bottom: 8px;
    }
    .dec dd,
    .dec dd:first-of-type {
      border-top: 0;
      padding-top: 0;
    }
    .legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .legend li:nth-child(4) {
      border-left: 1px solid var(--line2);
    }
    .legend li:nth-child(odd) {
      border-left: 0;
    }
    .legend li:nth-child(n + 3) {
      border-top: 1px solid var(--line2);
    }
  }
</style>
